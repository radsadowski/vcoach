# PostgreSQL — used by docker compose and local dev.
POSTGRES_PASSWORD=vcoach
DATABASE_URL=postgres://vcoach:vcoach@localhost:5432/vcoach?sslmode=disable

# Go API listen port.
PORT=8080

# LLM provider — any OpenAI-compatible Chat Completions endpoint.
# Default targets OpenRouter (https://openrouter.ai); base URL, key and model
# are the only things you change to swap providers.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Garmin Connect Personal API key. Created at Garmin Connect Web →
# Personal API Key page (shown once, expires after 30 days to 1 year).
GARMIN_API_KEY=

# Scheduled Garmin sync interval in minutes.
SYNC_INTERVAL_MIN=60
